{
  "name": "@constellation/hydra",
  "version": "0.1.0",
  "description": "Euclid Development Environment CLI — TypeScript rewrite of the hydra bash CLI",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "hydra": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"const fs=require('fs'); const f='dist/cli.js'; const c=fs.readFileSync(f,'utf8'); if(!c.startsWith('#!/usr/bin/env node')) fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c); fs.chmodSync(f, '755');\"",
    "build:watch": "tsc -p tsconfig.json --watch",
    "dev": "ts-node src/cli.ts",
    "link": "npm run build && npm link",
    "unlink": "npm unlink -g @constellation/hydra",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "oclif": {
    "bin": "hydra",
    "dirname": "hydra",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "local": {
        "description": "Manage local Docker-based development environment"
      },
      "remote": {
        "description": "Manage remote cloud-based metagraph deployment via Ansible"
      },
      "completion": {
        "description": "Manage shell tab-completion scripts for hydra"
      }
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "execa": "^9",
    "inquirer": "^9",
    "js-yaml": "^4",
    "node-ssh": "^13.2.1",
    "ora": "^9.3.0",
    "tabtab": "^3.0.2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
